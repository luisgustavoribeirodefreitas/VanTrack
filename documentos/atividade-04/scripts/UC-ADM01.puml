@startuml UC-ADM01
title UC-ADM01 — Vincular Motorista à Van (Administrativo)
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Empresa de Transporte" as E
boundary "PainelVans" as T
control "VanController" as C
participant "VanService" as S
entity "Van" as V
database "VanRepository" as VanRepo
database "MotoristaRepository" as MRepo

E -> T : definirMotorista(vanId)
T -> C : buscarMotoristaAtivo(vanId)
C -> S : buscarMotoristaAtivo(vanId)
S -> VanRepo : buscarPorId(vanId)
VanRepo --> S : van (com vínculo ativo, se houver)
S --> C : motorista ativo atual
C --> T : motorista ativo atual
T --> E : exibe o motorista ativo atual (se houver)

E -> T : selecionar(novoMotorista, inicio)
T -> C : vincularMotorista(vanId, motoristaId, inicio)
C -> S : vincularMotorista(vanId, motoristaId, inicio)
S -> MRepo : buscarPorId(motoristaId)
MRepo --> S : motorista

alt Caminho de sucesso — van e motorista ativos
    opt há vínculo ativo anterior (A1: van sem motorista pula este trecho)
        S -> V : encerrarVinculoAtivo(inicio) — registra data/horário de encerramento
    end
    S -> V : ativarVinculo(motorista, inicio) (RN-012)
    S -> VanRepo : salvar(van)
    VanRepo --> S : vínculo salvo
    S --> C : vínculo ativado
    C --> T : motorista ativo e histórico
    T --> E : exibe o motorista ativo atualizado e o histórico
else E1 — Motorista ou van inexistente/inativo
    S --> C : vínculo recusado
    C --> T : vínculo recusado
    T --> E : informa o motivo
end
@enduml
