@startuml UC-S01
title UC-S01 — Vincular Usuário à Empresa
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Responsável / Aluno" as U
boundary "TelaVinculo" as T
control "VinculoController" as C
participant "VinculoService" as S
entity "CodigoAcesso" as Cod
database "CodigoAcessoRepository" as CodRepo
database "VinculoRepository" as VRepo

U -> T : solicitarVinculo()
T --> U : solicita o código de vinculação
U -> T : informarCodigo(codigo)
T -> C : vincular(usuarioId, codigo)
C -> S : vincular(usuarioId, codigo)
S -> CodRepo : buscarPorCodigo(codigo)
CodRepo --> S : codigoAcesso
S -> Cod : validar() (RN-001)
Cod --> S : situação do código

alt Caminho de sucesso — código válido e ativo
    S -> Cod : obterDestino()
    Cod --> S : empresa, van e/ou aluno

    opt A1 — Responsável com mais de um aluno
        S -> VRepo : listarVinculos(usuarioId)
        VRepo --> S : vínculos anteriores (mantidos)
    end

    create entity "Vinculo" as V
    S -> V : new(usuario, empresa, van, aluno)
    S -> VRepo : salvar(vinculo) (RN-002, RN-009)
    VRepo --> S : vínculo salvo
    S --> C : vínculo criado
    C --> T : vinculoCriado(van, rota)
    T --> U : exibe a van/rota vinculada e libera as funcionalidades
else E1 — Código inválido
    S --> C : erro "código inválido"
    C --> T : vínculo recusado
    T --> U : informa o erro e solicita o código novamente
else E2 — Código expirado ou desativado
    S --> C : erro "código expirado/desativado"
    C --> T : vínculo recusado
    T --> U : orienta a solicitar novo código à empresa
end
@enduml
