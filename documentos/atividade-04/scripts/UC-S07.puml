@startuml UC-S07
title UC-S07 — Emitir Aviso de Atraso
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Motorista" as M
boundary "TelaRotaDoDia" as T
control "AtrasoController" as C
participant "AtrasoService" as S
database "AvisoAtrasoRepository" as ARepo

M -> T : avisarAtraso()
T -> C : abrirAviso(rotaId)
C -> S : buscarAvisoAutomatico(rotaId)
S -> ARepo : buscarAvisoDoDia(rotaId)
ARepo --> S : aviso automático (se houver)
S --> C : dados do aviso
C --> T : dados do aviso
T --> M : exibe o formulário de aviso de atraso

opt A1 — Já houve aviso automático (UC-S11)
    T --> M : mostra o aviso automático para o motorista complementar o motivo
end

M -> T : informar(motivo opcional, nova previsão)
M -> T : confirmarEnvio()

alt Caminho de sucesso — com conectividade
    T -> C : emitirAviso(rotaId, motivo, previsao)
    C -> S : emitirAviso(rotaId, motivo, previsao)
    create entity "AvisoAtraso" as A
    S -> A : new(rota, motivo, previsao, origem = manual)

    ref over S, ARepo : «include» UC-I03 — Notificar Responsáveis sobre Atraso (RN-014)

    S -> ARepo : salvar(aviso)
    ARepo --> S : aviso registrado
    S --> C : aviso enviado
    C --> T : aviso enviado
    T --> M : confirma o envio
else E1 — Sem conectividade (RNF-003)
    T --> M : informa que o aviso não pôde ser enviado
    T --> M : permite tentar novamente (retorna ao envio)
end
@enduml
