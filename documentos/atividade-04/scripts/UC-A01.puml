@startuml UC-A01
title UC-A01 — Manter Cadastro Base (Abstrato)
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Usuário" as U
boundary "Tela<Entidade>" as T
control "<Entidade>Controller" as C
participant "<Entidade>Service" as S
entity "<Entidade>" as E
database "<Entidade>Repository" as Repo

note over U, Repo : Padrão genérico — especializado por casos de uso\nconcretos, como UC-C01 (Manter Aluno)

U -> T : acessarModulo()
T -> C : listar(usuarioId)
C -> S : listar(usuarioId)
S -> Repo : buscarPermitidos(usuarioId)
Repo --> S : registros
S --> C : registros
C --> T : registros
T --> U : exibe a listagem

U -> T : escolher criar, editar ou desativar
U -> T : informar os dados / selecionar o registro
T -> C : salvar(acao, dados)
C -> S : salvar(acao, dados)
S -> E : validar()
E --> S : válido / inválido

alt Caminho de sucesso — dados válidos
    S -> Repo : salvar(entidade) (criar, atualizar ou desativar)
    Repo --> S : ok
    S --> C : listagem atualizada
    C --> T : listagem atualizada
    T --> U : exibe a listagem atualizada
else Dados inválidos
    S --> C : erros de validação
    C --> T : erros de validação
    T --> U : informa os erros e mantém os dados preenchidos
end
@enduml
