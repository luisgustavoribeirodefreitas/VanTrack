@startuml UC-X01
title UC-X01 — Registrar Autorização do Responsável Legal («extend» de UC-C01)
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Responsável" as R
boundary "TelaCadastroAluno" as T
control "AlunoController" as C
participant "AlunoService" as S
entity "Aluno" as A
database "AutorizacaoRepository" as AuRepo
database "VinculoRepository" as VRepo

note over T, S : Condição de extensão: no passo 4 do UC-C01\no aluno foi identificado como menor de idade

T --> R : informa que o cadastro de menor exige autorização (RN-016)
T --> R : exibe o termo de autorização

alt Caminho de sucesso — responsável aceita o termo
    R -> T : aceitarTermo()
    T -> C : registrarAutorizacao(responsavelId, alunoId)
    C -> S : registrarAutorizacao(responsavelId, alunoId)
    create entity "AutorizacaoLegal" as Au
    S -> Au : new(responsavel, aluno, dataHora)
    S -> AuRepo : salvar(autorizacao)
    S -> VRepo : vincular(responsavel, aluno) (RN-009)
    S -> A : registrarAutorizacao(autorizacao)
    S --> C : autorização registrada
    C --> T : cadastro liberado para ativação
    note over T : Retorna ao passo 5 do UC-C01
else E1 — Responsável recusa a autorização
    R -> T : recusarTermo()
    T -> C : manterPendente(alunoId)
    C -> S : manterPendente(alunoId)
    S -> A : marcarPendente() — sem coletar dados pessoais nem de localização
    S --> C : cadastro pendente
    C --> T : cadastro pendente
    T --> R : informa que o cadastro permanece pendente (UC-C01, E2)
end
@enduml
