@startuml UC-S02
title UC-S02 — Acompanhar Van em Tempo Real
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Responsável / Aluno" as U
boundary "TelaAcompanhamento" as T
control "RastreamentoController" as C
participant "RastreamentoService" as S
database "VinculoRepository" as VRepo
database "RotaRepository" as RRepo
participant "Serviço de Geolocalização" as Geo <<sistema externo>>

U -> T : selecionarAluno(alunoId)
T -> C : obterPosicaoVan(usuarioId, alunoId)
C -> S : obterPosicaoVan(usuarioId, alunoId)
S -> VRepo : buscarVinculo(usuarioId, alunoId)
VRepo --> S : vínculo e consentimento (RN-002, RN-003)

alt E2 — Usuário sem vínculo com a van
    S --> C : acesso negado
    C --> T : acesso negado
    T --> U : bloqueia a visualização
else vínculo válido
    S -> RRepo : buscarRotaAtiva(van)
    RRepo --> S : rota do dia

    alt A1 — Van ainda não iniciou a rota
        S --> C : rota não iniciada
        C --> T : rota não iniciada
        T --> U : informa que a rota ainda não foi iniciada
    else Caminho de sucesso — van em operação
        S -> Geo : obterLocalizacaoAtual(van)
        Geo --> S : posição e horário da leitura
        S --> C : posição + ponto de parada do aluno
        C --> T : posição + ponto de parada
        T --> U : exibe a van no mapa com o ponto de parada

        loop a cada 15 segundos (RNF-001)
            alt conexão ativa
                T -> C : atualizarPosicao(van)
                C -> S : obterPosicaoVan(usuarioId, alunoId)
                S -> Geo : obterLocalizacaoAtual(van)
                Geo --> S : nova posição
                S --> C : nova posição
                C --> T : nova posição
                T --> U : atualiza o mapa
            else E1 — Perda de conectividade
                T --> U : mantém a última posição com aviso de dado\ndesatualizado e horário da última atualização (RNF-003)
            end
        end
    end
end
@enduml
