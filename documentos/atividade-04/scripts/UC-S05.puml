@startuml UC-S05
title UC-S05 — Registrar Embarque
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Motorista" as M
boundary "TelaRotaDoDia" as T
participant "ArmazenamentoLocal\n(dispositivo)" as Local
control "EmbarqueController" as C
participant "EmbarqueService" as S
entity "Presenca" as P
database "PresencaRepository" as PRepo

M -> T : abrirRota(rotaId)
T -> C : listarAlunosConfirmados(rotaId)
C -> S : listarAlunosConfirmados(rotaId)
S -> PRepo : buscarConfirmados(rotaId)
PRepo --> S : alunos confirmados (ausentes não entram — RN-010)
S --> C : alunos na ordem da rota
C --> T : alunos na ordem da rota
T --> M : exibe os alunos confirmados

M -> T : confirmarEmbarque(alunoId)
T -> T : captura data, horário e localização

alt Caminho de sucesso — com conectividade
    T -> C : registrarEmbarque(alunoId, dataHora, local)
    C -> S : registrarEmbarque(alunoId, dataHora, local)
    S -> PRepo : buscarPresenca(alunoId, rotaId)
    PRepo --> S : presença
    S -> P : registrarEmbarque(dataHora, local) — status "embarcado"
    S -> PRepo : salvar(presenca)
    PRepo --> S : presença salva

    ref over S, PRepo : «include» UC-I02 — Notificar Responsável sobre Embarque/Desembarque

    S --> C : embarque registrado
    C --> T : embarque registrado
    T --> M : confirma o registro
else A1 — Sem conectividade (RNF-006)
    T -> Local : guardar(registroEmbarque)
    T --> M : registro salvo (pendente de sincronização)
    ... ao reconectar ...
    Local -> C : sincronizar(registros)
    C -> S : registrarEmbarque(alunoId, dataHora, local)
    S -> P : registrarEmbarque(dataHora, local) — status "embarcado"
    S -> PRepo : salvar(presenca)
    ref over S, PRepo : «include» UC-I02 (notificação enviada após a sincronização)
end
@enduml
