@startuml UC-I01
title UC-I01 — Notificar Motorista sobre Cancelamento («include» de UC-S04)
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

participant "PresencaService\n(UC-S04)" as PS
participant "NotificacaoService" as S
database "RotaRepository" as RRepo
database "VanRepository" as VanRepo
participant "Serviço de Notificação" as Push <<sistema externo>>
actor "Motorista" as M
database "NotificacaoRepository" as NRepo

note over PS : Gatilho: cancelamento registrado no UC-S04

PS -> S : notificarCancelamento(presenca)
S -> RRepo : buscarRotaDoAluno(aluno)
RRepo --> S : rota
S -> VanRepo : buscarMotoristaAtivo(van) (RN-012)
VanRepo --> S : motorista
S -> Push : enviar(motorista, "<aluno> cancelou o transporte")
Push --> M : notificação de cancelamento
S -> NRepo : registrarComunicado(cancelamento) (RN-007)
S --> PS : motorista notificado
@enduml
