@startuml UC-S04
title UC-S04 — Cancelar Utilização do Transporte
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Responsável / Aluno" as U
boundary "TelaPresenca" as T
control "PresencaController" as C
participant "PresencaService" as S
entity "Presenca" as P
database "PresencaRepository" as PRepo
database "RotaRepository" as RRepo

U -> T : cancelarPresenca(alunoId, trajetoId)
T -> C : solicitarCancelamento(alunoId, trajetoId)
C -> S : verificarCancelamento(alunoId, trajetoId)
S -> PRepo : buscarPresenca(alunoId, trajetoId)
PRepo --> S : presença
S -> P : podeCancelar() (RN-006)
P --> S : embarque registrado? sim / não

alt Caminho de sucesso — embarque ainda não registrado
    S --> C : cancelamento permitido
    C --> T : cancelamento permitido
    T --> U : "Deseja cancelar a presença?"
    U -> T : confirmar()
    T -> C : confirmarCancelamento(alunoId, trajetoId)
    C -> S : cancelar(alunoId, trajetoId)
    S -> P : cancelar(dataHora) — status "ausente"
    S -> PRepo : salvar(presenca)
    PRepo --> S : presença salva

    ref over S, RRepo : «include» UC-I01 — Notificar Motorista sobre Cancelamento (RN-007)

    S -> RRepo : buscarRotaDoDia(trajetoId)
    RRepo --> S : rota (se já gerada)
    opt «extend» UC-X02 — [rota do dia já gerada] (RN-008)
        ref over S, RRepo : UC-X02 — Recalcular Rota
    end

    S --> C : cancelamento concluído
    C --> T : cancelamento concluído
    T --> U : exibe "Presença cancelada"
else E1 — Embarque já registrado (RN-006)
    S --> C : cancelamento negado
    C --> T : cancelamento negado
    T --> U : informa o motivo
end
@enduml
