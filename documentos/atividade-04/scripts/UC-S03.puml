@startuml UC-S03
title UC-S03 — Confirmar Presença
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Responsável / Aluno" as U
boundary "TelaPresenca" as T
control "PresencaController" as C
participant "PresencaService" as S
entity "Trajeto" as Tr
database "TrajetoRepository" as TrRepo
database "PresencaRepository" as PRepo

U -> T : abrirConfirmacao()
T -> C : listarAlunosETrajetos(usuarioId)
C -> S : listarAlunosETrajetos(usuarioId)
S -> TrRepo : buscarPorResponsavel(usuarioId)
TrRepo --> S : alunos e trajetos
S --> C : alunos e trajetos disponíveis
C --> T : alunos e trajetos disponíveis
T --> U : exibe alunos, datas e trajetos

U -> T : selecionar(alunoId, trajetoId)
T -> C : verificarSituacao(alunoId, trajetoId)
C -> S : verificarSituacao(alunoId, trajetoId)
S -> TrRepo : buscarPorId(trajetoId)
TrRepo --> S : trajeto
S -> Tr : prazoConfirmacaoAberto(agora) (RN-004)
Tr --> S : prazo aberto / encerrado
S -> PRepo : buscarPresenca(alunoId, trajetoId)
PRepo --> S : presença (se existir)

alt Caminho de sucesso — prazo aberto e sem presença confirmada
    S --> C : liberado para confirmar
    C --> T : liberado para confirmar
    T --> U : solicita a confirmação
    U -> T : confirmar()
    T -> C : confirmarPresenca(alunoId, trajetoId)
    C -> S : confirmarPresenca(alunoId, trajetoId)
    create entity "Presenca" as P
    S -> P : new(aluno, trajeto, dataHora) — status "confirmada"
    S -> PRepo : salvar(presenca)
    PRepo --> S : presença salva
    S --> C : presença confirmada
    C --> T : presença confirmada
    T --> U : exibe "Presença confirmada"
else A1 — Presença já confirmada
    S --> C : status atual = confirmada
    C --> T : status atual
    T --> U : exibe o status e oferece cancelar (UC-S04)
else E1 — Prazo encerrado (RN-004)
    S --> C : prazo encerrado
    C --> T : prazo encerrado
    T --> U : informa que o prazo terminou\n(aluno sem confirmação permanece ausente)
end
@enduml
