@startuml UC-S06
title UC-S06 — Registrar Desembarque
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Motorista" as M
boundary "TelaRotaDoDia" as T
participant "ArmazenamentoLocal\n(dispositivo)" as Local
control "EmbarqueController" as C
participant "EmbarqueService" as S
entity "Presenca" as P
database "PresencaRepository" as PRepo

M -> T : abrirAlunosEmbarcados(rotaId)
T -> C : listarEmbarcados(rotaId)
C -> S : listarEmbarcados(rotaId)
S -> PRepo : buscarEmbarcados(rotaId)
PRepo --> S : alunos embarcados
S --> C : alunos embarcados
C --> T : alunos embarcados
T --> M : exibe os alunos embarcados

M -> T : confirmarDesembarque(alunoId)
T -> T : captura data, horário e localização

alt com conectividade
    T -> C : registrarDesembarque(alunoId, dataHora, local)
    C -> S : registrarDesembarque(alunoId, dataHora, local)
    S -> PRepo : buscarPresenca(alunoId, rotaId)
    PRepo --> S : presença
    S -> P : possuiEmbarque() (RN-011)
    P --> S : sim / não

    alt Caminho de sucesso — embarque registrado no mesmo trajeto
        S -> P : registrarDesembarque(dataHora, local) — status "desembarcado"
        S -> PRepo : salvar(presenca)
        PRepo --> S : presença salva

        ref over S, PRepo : «include» UC-I02 — Notificar Responsável sobre Embarque/Desembarque

        S --> C : desembarque registrado
        C --> T : desembarque registrado
        T --> M : confirma o registro
    else E1 — Sem embarque registrado (RN-011)
        S --> C : desembarque não permitido
        C --> T : desembarque não permitido
        T --> M : informa o motivo
    end
else A1 — Sem conectividade (RNF-006)
    T -> Local : guardar(registroDesembarque)
    T --> M : registro salvo (pendente de sincronização)
    ... ao reconectar ...
    Local -> C : sincronizar(registros)
    C -> S : registrarDesembarque(alunoId, dataHora, local)
    note right of S : segue a mesma validação do embarque (RN-011)\ne inclui UC-I02 após a sincronização
end
@enduml
