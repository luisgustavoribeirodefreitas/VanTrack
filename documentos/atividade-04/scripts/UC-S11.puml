@startuml UC-S11
title UC-S11 — Detectar Atraso Automaticamente (automático)
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Tempo\n(agendador)" as Tempo
control "MonitorAtraso" as Mon
participant "AtrasoService" as S
database "RotaRepository" as RRepo
entity "Rota" as R
participant "Serviço de Geolocalização" as Geo <<sistema externo>>
database "AvisoAtrasoRepository" as ARepo
participant "Serviço de Notificação" as Push <<sistema externo>>
actor "Motorista" as M

Tempo -> Mon : verificacaoPeriodica(rotaId)
Mon -> S : avaliarAtraso(rotaId)
S -> RRepo : buscarPorId(rotaId)
RRepo --> S : rota (horário previsto de chegada)
S -> Geo : obterEstimativaChegada(rota)
Geo --> S : horário estimado
S -> R : calcularDesvio(horarioEstimado)
R --> S : desvio em minutos

alt Caminho de sucesso — desvio ≥ 10 minutos (limiar padrão, RN-014)
    create entity "AvisoAtraso" as A
    S -> A : new(rota, previsao, origem = automático)

    ref over S, ARepo : «include» UC-I03 — Notificar Responsáveis sobre Atraso

    S -> ARepo : salvar(aviso) — atraso comunicado
    S -> Push : notificar(motorista, "aviso de atraso enviado")
    Push --> M : pode complementar o motivo (UC-S07, A1)
else A1 — Desvio abaixo do limiar
    S -> S : nenhuma notificação é gerada
end
@enduml
