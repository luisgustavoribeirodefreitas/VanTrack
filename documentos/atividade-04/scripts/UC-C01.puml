@startuml UC-C01
title UC-C01 — Manter Aluno (Concreto / CRUD) — cenário "cadastrar"
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Responsável\n(ou aluno maior de idade)" as U
boundary "TelaCadastroAluno" as T
control "AlunoController" as C
participant "AlunoService" as S
database "AlunoRepository" as ARepo

U -> T : novoAluno()
T --> U : solicita os dados obrigatórios (inclui data de nascimento)
U -> T : informarDados(dados)
T -> C : validarDados(dados)
C -> S : validarDados(dados)

alt E1 — Dados obrigatórios ausentes
    S --> C : campos inválidos
    C --> T : campos inválidos
    T --> U : destaca os campos e mantém os dados preenchidos\n(retorna ao informe dos dados)
else dados completos
    create entity "Aluno" as A
    S -> A : new(dados) — status "pendente"
    S -> A : ehMenorDeIdade()
    A --> S : menor / maior

    alt aluno menor de idade
        ref over U, S : «extend» UC-X01 — Registrar Autorização do Responsável Legal (RN-016)
    else A1 — Aluno maior de idade se cadastrando
        S -> S : UC-X01 não é executado (exceção da RN-016)
    end

    S --> C : dados válidos
    C --> T : solicitar consentimento
    T --> U : solicita o consentimento para dados e localização (RN-003)
    U -> T : registrarConsentimento() e salvar()
    T -> C : salvarAluno(alunoId, consentimento)
    C -> S : salvarAluno(alunoId, consentimento)
    S -> A : registrarConsentimento(consentimento)
    S -> A : podeAtivar() (RN-016)
    A --> S : sim / não

    alt Caminho de sucesso — autorização registrada (ou aluno maior)
        S -> A : ativar()
        S -> ARepo : salvar(aluno)
        ARepo --> S : aluno salvo
        S --> C : aluno ativo
        C --> T : aluno ativo
        T --> U : exibe o aluno na listagem
    else E2 — Autorização do responsável legal não registrada
        S -> ARepo : salvar(aluno) — status "pendente"
        S --> C : cadastro pendente
        C --> T : cadastro pendente
        T --> U : informa que o cadastro está pendente (não ativado)
    end
end

note across : Os fluxos A2 (edição) e A3 (desativação) seguem o padrão genérico do UC-A01.
@enduml
