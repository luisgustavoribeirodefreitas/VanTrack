@startuml UC-S08
title UC-S08 — Trocar Mensagens pelo Chat
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Usuário\n(Motorista/Responsável/Aluno)" as U
boundary "TelaChat" as T
control "ChatController" as C
participant "ChatService" as S
entity "Conversa" as Conv
database "ConversaRepository" as CRepo
participant "Serviço de Notificação" as Push <<sistema externo>>
actor "Demais participantes\nautorizados" as P

U -> T : abrirChat()
T -> C : listarConversas(usuarioId)
C -> S : listarConversas(usuarioId)
S -> CRepo : buscarConversasPermitidas(usuarioId)
CRepo --> S : conversas
S --> C : conversas
C --> T : conversas
T --> U : exibe as conversas acessíveis

U -> T : selecionarConversa(conversaId)
T -> C : abrirConversa(usuarioId, conversaId)
C -> S : abrirConversa(usuarioId, conversaId)
S -> CRepo : buscarPorId(conversaId)
CRepo --> S : conversa
S -> Conv : permiteAcesso(usuario) (RN-001, RN-002, RN-013)
Conv --> S : permitido / negado

alt Caminho de sucesso — usuário vinculado à rota
    S -> Conv : historico()
    Conv --> S : mensagens
    S --> C : histórico
    C --> T : histórico
    T --> U : exibe o histórico de mensagens

    U -> T : enviarMensagem(texto)
    alt conexão ativa
        T -> C : enviarMensagem(conversaId, texto)
        C -> S : enviarMensagem(usuarioId, conversaId, texto)
        S -> Conv : adicionarMensagem(autor, texto)
        S -> CRepo : salvar(conversa)
        CRepo --> S : mensagem armazenada
        S -> Push : entregar(participantes, mensagem)
        Push --> P : nova mensagem
        S --> C : mensagem enviada
        C --> T : mensagem enviada
        T --> U : exibe a mensagem no histórico
    else E3 — Sem conectividade (RNF-003)
        T --> U : informa que a mensagem não foi enviada e permite reenviar
    end
else E1 / E2 — Sem vínculo com a rota, ou conversa de outro responsável
    S --> C : acesso negado
    C --> T : acesso negado
    T --> U : bloqueia o acesso à conversa
end
@enduml
